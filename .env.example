# Salin jadi .env lalu isi. File .env sudah di-.gitignore, jangan di-commit.
BASE_URL=https://staging.app.optimark.ai
USER_EMAIL=
USER_PASSWORD=

# Opsional: akun kedua untuk tes isolasi data antar akun (E2E-05-21, 06-30, 07-36)
USER_B_EMAIL=
USER_B_PASSWORD=
# Opsional: akun yang BELUM onboarding (E2E-02-xx)
NEW_USER_EMAIL=
NEW_USER_PASSWORD=
# Opsional: path video MP4 valid untuk tes upload video Composer (E2E-04-26)
VIDEO_FILE=

HEADLESS=false
SLOW_MO=500
DEFAULT_TIMEOUT_MS=10000
# AI generate bisa lama (video beberapa menit)
GENERATE_TIMEOUT_MS=240000
