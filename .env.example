# Salin jadi .env lalu isi. File .env sudah di-.gitignore, jangan di-commit.
# PENTING: password yang memuat tanda # WAJIB diberi tanda kutip, mis. USER_PASSWORD="Abc12##"
# (tanpa kutip, # dianggap awal komentar dan password terpotong -> login ditolak 401).
BASE_URL=https://staging-app.optimark.ai
USER_EMAIL=
USER_PASSWORD=

# Opsional: akun kedua untuk tes isolasi data antar akun (ASST-21, IMG-30, VID-36)
USER_B_EMAIL=
USER_B_PASSWORD=
# Opsional: akun yang BELUM onboarding (ONB-xx)
NEW_USER_EMAIL=
NEW_USER_PASSWORD=

HEADLESS=false
SLOW_MO=1000
DEFAULT_TIMEOUT_MS=10000
# AI generate bisa lama (video beberapa menit)
GENERATE_TIMEOUT_MS=240000

# Opsional: untuk npm run test:ui. true = teks UI wajib persis bahasa Indonesia seperti Figma
STRICT_LANGUAGE=false
